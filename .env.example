# =============================================================================
# Dialarme — Générateur de devis. Environment reference.
# Copy to .env.local for local dev. Production values live in Vercel
# (Project > Settings > Environment Variables) and are the source of truth.
# =============================================================================
#
# IMPORTANT — a value set in Vercel OVERRIDES the fallback hardcoded in
# src/lib/config.ts. If a Drive document ever "goes missing" in production
# while the file is plainly there in Drive, check the variable here FIRST:
# the app fetches the ID from the env var, not the one you see in the code.
# /api/drive-fetch only serves IDs present in config (allowlist), so a stale
# env var makes the app answer 404 for the correct, perfectly shared file.

# --- Google OAuth (Drive access) --------------------------------------------
# The app authenticates as a single Google user (devis.dialarme@gmail.com),
# NOT a service account. Every Drive file below must be readable by that user.
# Regenerate the refresh token with: node scripts/get-refresh-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional alternative auth path, unused by the main flow.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Sheets (conseillers list) ---------------------------------------
# ID of the spreadsheet holding the "Conseiller" tab. Read live at runtime by
# src/lib/services/google-sheets.service.ts via /api/commercials.
# There is NO static fallback list: if this is unset or the sheet is
# unreachable, the conseiller dropdown renders EMPTY.
GOOGLE_SHEETS_ID=

# --- Drive: base templates (the "dossier" wrapped around each quote) --------
# The generated quote page is inserted at page 6 of these documents.
GOOGLE_DRIVE_FILE_ALARME_TITANE=
GOOGLE_DRIVE_FILE_ALARME_JABLOTRON=
GOOGLE_DRIVE_FILE_VIDEO=
GOOGLE_DRIVE_FILE_FOG=
GOOGLE_DRIVE_FILE_VISIOPHONE=

# --- Drive: optional appended documents -------------------------------------
# Left empty = silently skipped, the quote still generates.
GOOGLE_DRIVE_FILE_POLICE=
GOOGLE_DRIVE_FILE_ACCESSORIES=
GOOGLE_DRIVE_FILE_PROPERTY_LOCAUX=
GOOGLE_DRIVE_FILE_PROPERTY_HABITATION=
GOOGLE_DRIVE_FILE_PROPERTY_VILLA=
GOOGLE_DRIVE_FILE_PROPERTY_COMMERCE=
GOOGLE_DRIVE_FILE_PROPERTY_ENTREPRISE=

# --- Drive: camera product sheets (fiches techniques) -----------------------
# Direct IDs win over name-matching in GOOGLE_DRIVE_FOLDER_TECH_SHEETS.
GOOGLE_DRIVE_FILE_MINI_SOLAR=
GOOGLE_DRIVE_FILE_BULLET_MINI=
GOOGLE_DRIVE_FILE_DOME_MINI=
GOOGLE_DRIVE_FILE_BULLET_XL_VARIFOCALE=
GOOGLE_DRIVE_FILE_DOME_XL_VARIFOCALE=
GOOGLE_DRIVE_FILE_BULLET_ZOOM_PTZ=
GOOGLE_DRIVE_FILE_DOME_ANTIVANDALE=
GOOGLE_DRIVE_FILE_DOME_NIGHT=

# --- Drive: destination folders for saved quotes ----------------------------
GOOGLE_DRIVE_FOLDER_DEVIS=
GOOGLE_DRIVE_FOLDER_TITANE=
GOOGLE_DRIVE_FOLDER_JABLOTRON=
GOOGLE_DRIVE_FOLDER_VIDEO=
GOOGLE_DRIVE_FOLDER_XTO=
GOOGLE_DRIVE_FOLDER_DEVIS_XTO=
GOOGLE_DRIVE_FOLDER_TECH_SHEETS=
GOOGLE_DRIVE_FOLDER_PRODUCT_SHEETS=

# --- Email (SMTP via nodemailer) --------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=devis@dialarme.ch
EMAIL_INTERNAL=devis.dialarme@gmail.com

# --- Supabase (quote logging + dashboard, optional) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- PDF tuning -------------------------------------------------------------
# Position of the "de vos locaux" overlay on page 2 of the base template.
# Adjust these instead of editing code when the template moves.
PDF_PROPERTY_TYPE_X=
PDF_PROPERTY_TYPE_Y=
PDF_PROPERTY_TYPE_FONT_SIZE=
PDF_TIMEOUT_MS=30000

# --- Misc -------------------------------------------------------------------
# Base URL used by scripts/smoke-prod.mjs
PROD_URL=https://generateur-devis.vercel.app
